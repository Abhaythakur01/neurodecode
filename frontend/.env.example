# Frontend Environment Variables
# Copy this to .env.local for local development

# API URL (optional - defaults to same origin in production)
VITE_API_URL=

# WebSocket URL (optional - auto-detected based on environment)
# For production, set this to your backend WebSocket endpoint
# Example: wss://neurodecode-api.onrender.com/ws/decode
VITE_WS_URL=

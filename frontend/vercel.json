{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://neurodecode-api.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://neurodecode-api.onrender.com/health"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://neurodecode-api.onrender.com/ws/:path*"
    }
  ]
}
